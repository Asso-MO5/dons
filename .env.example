# Image de base utilisée en production (CapRover / Docker)
NODE_IMAGE=node:22-bookworm-slim

# === Variables OBLIGATOIRES ===

# URL publique (utilisée pour construire les liens absolus dans les mails)
BASE_URL=https://dons.mo5.com

# MySQL
DB_HOST=mysql
DB_USER=mo5_dons
DB_PASS=__A_REMPLACER__
DB_NAME=mo5_dons
DB_NAME_PROD=mo5_dons_prod
DB_USER_PROD=mo5_dons_prod
DB_PASS_PROD=__A_REMPLACER__

# SMTP
MAIL_HOST=smtp.example.com
MAIL_USERNAME=__A_REMPLACER__
MAIL_PASS=__A_REMPLACER__
MAIL_ADDRESS=asso@mo5.com
MAIL_DEST=tresorier@mo5.com
MAILS_COPY=president@mo5.com,secretaire@mo5.com

# Token admin (route admin)
TOKEN_ADMIN=__GENERER_UN_TOKEN_ALEA_OIRE__

# Discord (envoyé dans le mail d'adhésion)
DISCORD_LINK=https://discord.gg/mo5

# === Build args (Vite, baked-in) ===
# À passer au `docker build` :
#   docker build --build-arg VITE_PAYPAL_API_KEY=xxx --build-arg VITE_PAYPAL_MERCHANT_ID=yyy -t dons:local .
VITE_PAYPAL_API_KEY=__A_REMPLACER__
VITE_PAYPAL_MERCHANT_ID=__A_REMPLACER__
